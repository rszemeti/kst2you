# Connection details supplied by the Beast feed provider.
BEAST_HOST=feed.example.net
BEAST_PORT=replace-with-provider-port

LOCAL_API_PORT=8080

# Public DNS name pointing to this Lightsail instance's static IP.
DOMAIN_NAME=aircraft.example.net

# Email address used for Let's Encrypt expiry notices during bootstrap.
CERTBOT_EMAIL=admin@example.net

# Exact origins permitted to call the API. Add local ports here when needed.
CORS_ORIGINS=https://rszemeti.github.io,http://localhost:8000,http://127.0.0.1:8000